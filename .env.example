# Copy to .env and adjust. Never commit the real .env.

# Database (SQLite for local runs; docker-compose uses PostgreSQL)
DATABASE_URL=sqlite:///./jasipa.db

# Security: required outside local development. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=["http://localhost:5173"]

# LLM: "gemini" uses the API key below; "mock" runs fully offline with deterministic strategies.
LLM_PROVIDER=mock
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash

# Resume uploads (stored under random names, never served statically)
UPLOAD_DIR=./uploads
MAX_RESUME_BYTES=5242880

# Code sandbox: "subprocess" (default) or "docker" (no network, read-only filesystem; recommended in production)
SANDBOX_BACKEND=subprocess
SANDBOX_TIMEOUT_SECONDS=4
SANDBOX_MEMORY_MB=256

# Bias checks
BIAS_DISPARITY_THRESHOLD=0.80
BIAS_SIGNIFICANCE_LEVEL=0.05
BIAS_MIN_GROUP_SIZE=5

# Frontend (read by Vite at build time)
VITE_API_URL=http://localhost:8000
