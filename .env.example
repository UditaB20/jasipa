# Database URL (defaults to sqlite:///./jasipa.db for instant zero-dependency local run)
DATABASE_URL=sqlite:///./jasipa.db
# DATABASE_URL=postgresql://jasipa_user:jasipa_password@localhost:5432/jasipa_db

# Security
SECRET_KEY=jasipa-super-secret-jwt-key-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Configuration (Set to "mock" for instant offline evaluation, or "openai"/"gemini" with keys)
LLM_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=gpt-4o-mini

# Governance Thresholds
BIAS_DISPARITY_THRESHOLD=0.80
